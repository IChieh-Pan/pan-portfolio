---
import Layout from "./Layout.astro";
import { projects } from "../data/projects";

interface Props {
  slug: string;
  team?: string;
  externalLabel?: string;
  externalHref?: string;
  coverPlain?: boolean;
  readTime?: string;
  coverWidth?: string;
}
const {
  slug,
  team,
  externalLabel,
  externalHref,
  coverPlain = false,
  readTime,
  coverWidth,
} = Astro.props;

const idx = projects.findIndex((p) => p.slug === slug);
const project = projects[idx];
const next = projects[(idx + 1) % projects.length];
---

<Layout title={`${project.title} — I-Chieh Pan`} description={project.subtitle}>
  <!-- Top bar -->
  <header
    class="mx-auto flex max-w-5xl items-center justify-between px-6 py-6 sm:px-10"
  >
    <a href="/" class="font-display text-sm font-semibold tracking-tight"
      >I-Chieh Pan</a
    >
    <a
      href="/#work"
      class="group inline-flex items-center gap-2 text-sm font-medium text-[#0041d9]"
    >
      <span class="transition-transform group-hover:-translate-x-0.5">←</span>
      <span class="border-b border-[#0041d9]/30 pb-0.5 group-hover:border-[#0041d9]"
        >All work</span
      >
    </a>
  </header>

  <!-- Hero -->
  <section class="mx-auto max-w-5xl px-6 pt-8 pb-10 sm:px-10 sm:pt-12">
    <p class="font-mono text-sm uppercase tracking-wide text-[#0041d9]">
      {project.client}{readTime && ` · ${readTime}`}
    </p>
    <h1
      class="mt-3 font-display font-semibold leading-[0.98] tracking-[-0.02em] text-[#0041d9]"
      style="font-size:clamp(2.5rem,7vw,5rem)"
    >
      {project.title}
    </h1>
    <p class="mt-4 font-sans text-lg leading-snug text-ink/75 sm:text-xl">
      {project.subtitle}
    </p>

    <dl
      class="mt-10 grid grid-cols-2 gap-6 border-t border-line/70 pt-8 sm:grid-cols-4"
    >
      <div>
        <dt class="font-mono text-xs uppercase tracking-wide text-muted">Role</dt>
        <dd class="mt-1 text-sm">{project.role}</dd>
      </div>
      {
        team && (
          <div>
            <dt class="font-mono text-xs uppercase tracking-wide text-muted">
              Team
            </dt>
            <dd class="mt-1 text-sm" set:html={team} />
          </div>
        )
      }
      <div>
        <dt class="font-mono text-xs uppercase tracking-wide text-muted">Year</dt>
        <dd class="mt-1 text-sm">{project.year}</dd>
      </div>
      {
        externalHref && (
          <div>
            <dt class="font-mono text-xs uppercase tracking-wide text-muted">
              Live
            </dt>
            <dd class="mt-1 text-sm">
              <a
                href={externalHref}
                target="_blank"
                rel="noopener noreferrer"
                class="text-[#0041d9] underline-offset-4 hover:underline"
              >
                {externalLabel ?? "View"} ↗
              </a>
            </dd>
          </div>
        )
      }
    </dl>
  </section>

  <!-- Cover -->
  {
    project.cover && (
      <div class="mx-auto mt-6 mb-6 max-w-5xl px-6 sm:mb-10 sm:mt-10 sm:px-10">
        <img
          src={project.cover}
          alt={`${project.title} cover`}
          class:list={[
            "w-full rounded-3xl",
            coverWidth && `mx-auto ${coverWidth}`,
            !coverPlain &&
              "bg-card shadow-[0_24px_70px_-30px_rgba(16,24,40,0.35)]",
          ]}
        />
      </div>
    )
  }

  <!-- Optional top metrics strip -->
  <slot name="metrics" />

  <!-- Body -->
  <main class="space-y-16 py-12 sm:space-y-24 sm:py-16">
    <slot />
  </main>

  <!-- Next project -->
  <section class="mx-auto max-w-5xl px-6 pt-24 pb-24 sm:px-10 sm:pt-32">
    <a
      href={`/work/${next.slug}`}
      class="group block rounded-3xl border-2 border-line px-8 py-12 transition-all duration-200 hover:-translate-y-1 hover:border-[#006a6c] sm:px-10 sm:py-16"
    >
      <p class="font-mono text-xs uppercase tracking-wide text-muted">
        Next project
      </p>
      <p
        class="mt-3 font-display text-3xl font-semibold tracking-tight text-[#006a6c] sm:text-5xl"
      >
        {next.client} — {next.title}
      </p>
    </a>
  </section>

  <footer class="border-t border-line">
    <div
      class="mx-auto flex max-w-5xl flex-col gap-2 px-6 py-8 font-sans text-xs text-muted sm:flex-row sm:items-center sm:justify-between sm:px-10"
    >
      <span>© {new Date().getFullYear()} I-Chieh Pan</span>
      <a href="/#contact" class="hover:text-ink">Get in touch →</a>
    </div>
  </footer>

  <!-- Lightbox: click any content image to view the full, uncropped original -->
  <div
    id="lightbox"
    class="fixed inset-0 z-[100] hidden cursor-zoom-out items-center justify-center bg-ink/90 p-4 backdrop-blur-sm sm:p-8"
    aria-hidden="true"
  >
    <img
      id="lightbox-img"
      src=""
      alt=""
      class="max-h-[92vh] max-w-[94vw] rounded-lg object-contain shadow-2xl"
    />
    <button
      id="lightbox-close"
      aria-label="Close"
      class="fixed right-5 top-5 font-mono text-xs uppercase tracking-wide text-page/70 hover:text-page"
    >
      Close ✕
    </button>
  </div>

  <script>
    const lb = document.getElementById("lightbox");
    const lbImg = document.getElementById("lightbox-img") as HTMLImageElement | null;
    if (lb && lbImg) {
      const open = (src: string, alt: string) => {
        lbImg.src = src;
        lbImg.alt = alt;
        lb.classList.remove("hidden");
        lb.classList.add("flex");
        lb.setAttribute("aria-hidden", "false");
        document.body.style.overflow = "hidden";
      };
      const close = () => {
        lb.classList.add("hidden");
        lb.classList.remove("flex");
        lb.setAttribute("aria-hidden", "true");
        document.body.style.overflow = "";
        lbImg.src = "";
      };
      document
        .querySelectorAll<HTMLImageElement>("img:not(#lightbox-img)")
        .forEach((img) => {
          img.style.cursor = "zoom-in";
          img.addEventListener("click", () =>
            open(img.currentSrc || img.src, img.alt),
          );
        });
      lb.addEventListener("click", close);
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") close();
      });
    }
  </script>
</Layout>
