---
import Layout from "./Layout.astro";
import { projects } from "../data/projects";

interface Props {
  slug: string;
  team?: string;
  externalLabel?: string;
  externalHref?: string;
}
const { slug, team, externalLabel, externalHref } = Astro.props;

const idx = projects.findIndex((p) => p.slug === slug);
const project = projects[idx];
const next = projects[(idx + 1) % projects.length];
---

<Layout title={`${project.title} — I-Chieh Pan`} description={project.subtitle}>
  <!-- Top bar -->
  <header
    class="mx-auto flex max-w-5xl items-center justify-between px-6 py-6 sm:px-10"
  >
    <a href="/" class="font-display text-sm font-semibold tracking-tight"
      >I-Chieh Pan</a
    >
    <a
      href="/#work"
      class="group inline-flex items-center gap-2 text-sm font-medium text-[#0041d9]"
    >
      <span class="transition-transform group-hover:-translate-x-0.5">←</span>
      <span class="border-b border-[#0041d9]/30 pb-0.5 group-hover:border-[#0041d9]"
        >All work</span
      >
    </a>
  </header>

  <!-- Hero -->
  <section class="mx-auto max-w-5xl px-6 pt-8 pb-10 sm:px-10 sm:pt-12">
    <p class="font-mono text-sm uppercase tracking-wide text-[#0041d9]">
      {project.client}
    </p>
    <h1
      class="mt-3 font-display font-semibold leading-[0.98] tracking-[-0.02em] text-[#0041d9]"
      style="font-size:clamp(2.5rem,7vw,5rem)"
    >
      {project.title}
    </h1>
    <p class="mt-3 font-serif text-2xl italic text-ink/80 sm:text-3xl">
      {project.subtitle}
    </p>

    <dl
      class="mt-10 grid grid-cols-2 gap-6 border-t border-line/70 pt-8 sm:grid-cols-4"
    >
      <div>
        <dt class="font-mono text-xs uppercase tracking-wide text-muted">Role</dt>
        <dd class="mt-1 text-sm">{project.role}</dd>
      </div>
      {
        team && (
          <div>
            <dt class="font-mono text-xs uppercase tracking-wide text-muted">
              Team
            </dt>
            <dd class="mt-1 text-sm">{team}</dd>
          </div>
        )
      }
      <div>
        <dt class="font-mono text-xs uppercase tracking-wide text-muted">Year</dt>
        <dd class="mt-1 text-sm">{project.year}</dd>
      </div>
      {
        externalHref && (
          <div>
            <dt class="font-mono text-xs uppercase tracking-wide text-muted">
              Live
            </dt>
            <dd class="mt-1 text-sm">
              <a
                href={externalHref}
                target="_blank"
                rel="noopener noreferrer"
                class="text-[#0041d9] underline-offset-4 hover:underline"
              >
                {externalLabel ?? "View"} ↗
              </a>
            </dd>
          </div>
        )
      }
    </dl>
  </section>

  <!-- Cover -->
  <div class="mx-auto max-w-5xl px-6 sm:px-10">
    <img
      src={project.cover}
      alt={`${project.title} cover`}
      class="w-full rounded-3xl bg-card shadow-[0_24px_70px_-30px_rgba(16,24,40,0.35)]"
    />
  </div>

  <!-- Body -->
  <main class="space-y-12 py-12 sm:space-y-16 sm:py-16">
    <slot />
  </main>

  <!-- Next project -->
  <section class="mx-auto max-w-5xl px-6 pb-24 sm:px-10">
    <a
      href={`/work/${next.slug}`}
      class="group block rounded-3xl bg-card p-8 shadow-[0_18px_50px_-28px_rgba(16,24,40,0.3)] transition-transform hover:-translate-y-1 sm:p-10"
    >
      <p class="font-mono text-xs uppercase tracking-wide text-muted">
        Next project
      </p>
      <p
        class="mt-2 font-display text-2xl font-semibold tracking-tight sm:text-3xl"
      >
        {next.client} — {next.title}
      </p>
      <p class="mt-1 font-serif text-xl italic text-ink/70">{next.subtitle}</p>
      <span class="mt-4 inline-block text-sm font-medium text-[#0041d9]"
        >View case study →</span
      >
    </a>
  </section>

  <footer class="border-t border-line">
    <div
      class="mx-auto flex max-w-5xl flex-col gap-2 px-6 py-8 font-sans text-sm text-muted sm:flex-row sm:items-center sm:justify-between sm:px-10"
    >
      <span>© {new Date().getFullYear()} I-Chieh Pan</span>
      <a href="/#contact" class="hover:text-ink">Get in touch →</a>
    </div>
  </footer>
</Layout>
