          <!-- Entities -> Rules -->
          <line x1="122" y1="75" x2="205" y2="75" stroke="#6c685f" stroke-width="1.5" marker-end="url(#scArrow)"/>
          <line x1="122" y1="150" x2="205" y2="150" stroke="#6c685f" stroke-width="1.5" marker-end="url(#scArrow)"/>
          <line x1="122" y1="225" x2="205" y2="225" stroke="#6c685f" stroke-width="1.5" marker-end="url(#scArrow)"/>

          <!-- Rule nodes -->
          <rect x="212" y="53" width="168" height="44" rx="8" fill="#ffffff" stroke="#514d45" stroke-width="1.5"/>
          <text x="228" y="72" fill="#514d45" font-size="13" font-weight="600">Rule</text>
          <text x="228" y="88" fill="#6c685f" font-size="10" font-family="ui-monospace, monospace">a query</text>
