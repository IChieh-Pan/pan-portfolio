          <text x="235" y="20" fill="#6c685f" font-size="11" letter-spacing="1.5" font-family="ui-monospace, monospace">RULES</text>
          <text x="565" y="20" fill="#6c685f" font-size="11" letter-spacing="1.5" font-family="ui-monospace, monospace">SCORECARD</text>

          <!-- Entities: row 1 (2/5) -->
