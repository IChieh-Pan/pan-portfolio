          <circle cx="104" cy="75" r="6" fill="#f2e8e3" stroke="#d9d5cc"/>
          <!-- Entities: row 2 (3/5) -->
          <circle cx="24" cy="150" r="6" fill="#0041d9"/>
          <circle cx="44" cy="150" r="6" fill="#0041d9"/>
          <circle cx="64" cy="150" r="6" fill="#0041d9"/>
          <circle cx="84" cy="150" r="6" fill="#f2e8e3" stroke="#d9d5cc"/>
          <circle cx="104" cy="150" r="6" fill="#f2e8e3" stroke="#d9d5cc"/>
          <!-- Entities: row 3 (1/5) -->
          <circle cx="24" cy="225" r="6" fill="#0041d9"/>
          <circle cx="44" cy="225" r="6" fill="#f2e8e3" stroke="#d9d5cc"/>
          <circle cx="64" cy="225" r="6" fill="#f2e8e3" stroke="#d9d5cc"/>
