---
import Layout from "../layouts/Layout.astro";
import { projects } from "../data/projects";

// Your location powers the live clock in the top bar.
// TODO: confirm your city (currently a guess).
const LOCATION = { city: "Taipei", tz: "Asia/Taipei" };

const LINKS = {
  linkedin: "https://www.linkedin.com/in/ichieh-pan-919344b3/",
  github: "https://github.com/ichieh-pan",
  resume:
    "https://drive.google.com/file/d/1MVwI1dfrhawCBHaIXMVsvl0lk-nT-ZiO/view?usp=sharing",
  aiApp: "https://ai-content-aggregator.vercel.app/",
};

const CAREER = [
  { org: "New Relic", role: "Sr. Product Designer", period: "2022 — now" },
  { org: "dunnhumby", role: "Sr. Product Designer", period: "2021 — 2022" },
  { org: "ITONICS", role: "UX/UI Designer", period: "2019 — 2020" },
  { org: "Durch die Stadt", role: "UX/UI Designer", period: "2017 — 2018" },
  { org: "ACER", role: "Design Specialist", period: "2015" },
];
---

<Layout>
  <!-- ===================== Top bar ===================== -->
  <header
    class="fixed inset-x-0 top-0 z-50 mix-blend-difference"
    style="color:#fff"
  >
    <div
      class="mx-auto flex max-w-[1400px] items-center justify-between px-6 py-5 sm:px-10"
    >
      <a href="#top" class="font-display text-sm font-semibold tracking-tight">
        I-Chieh Pan
      </a>
      <nav class="flex items-center gap-6 font-sans text-xs tracking-wide">
        <span class="hidden tabular-nums uppercase opacity-70 sm:inline">
          {LOCATION.city}&nbsp;<span id="clock">--:--:--</span>
        </span>
        <a href="#work" class="hover:opacity-60">Work</a>
        <a href="#about" class="hover:opacity-60">About</a>
        <a href="#contact" class="hover:opacity-60">Contact</a>
      </nav>
    </div>
  </header>

  <main id="top" class="mx-auto max-w-[1400px] px-6 sm:px-10">
    <!-- ===================== Hero ===================== -->
    <section
      class="relative flex min-h-[92svh] flex-col items-center justify-center pt-28 pb-20 text-center"
    >
      <!-- Floating image — left / upper (desktop only) -->
      <figure
        class="absolute left-0 top-[18%] z-0 hidden w-[clamp(180px,16vw,240px)] -rotate-3 xl:block"
      >
        <img
          src="https://picsum.photos/seed/pan-desk/600/440"
          alt=""
          loading="lazy"
          class="w-full rounded-2xl object-cover shadow-[0_18px_50px_-20px_rgba(16,24,40,0.35)]"
        />
        <figcaption
          class="mt-2 text-left font-mono text-[11px] uppercase tracking-wide text-[#0041d9]"
        >
          [09:14] first coffee, first figma
        </figcaption>
      </figure>

      <!-- Floating image — right / lower (desktop only) -->
      <figure
        class="absolute right-0 bottom-[14%] z-0 hidden w-[clamp(180px,16vw,240px)] rotate-3 xl:block"
      >
        <img
          src="https://picsum.photos/seed/pan-screen/600/440"
          alt=""
          loading="lazy"
          class="w-full rounded-2xl object-cover shadow-[0_18px_50px_-20px_rgba(16,24,40,0.35)]"
        />
        <figcaption
          class="mt-2 text-right font-mono text-[11px] uppercase tracking-wide text-[#0041d9]"
        >
          [16:07] watching the model think
        </figcaption>
      </figure>

      <!-- Hero text -->
      <div class="relative z-10 max-w-3xl">
        <p
          class="mb-6 font-sans text-[22px] leading-relaxed text-[#0041d9] sm:whitespace-nowrap sm:text-[24px]"
        >
          7+ years designing complex, data-heavy products.
        </p>
        <h1
          class="font-display font-semibold leading-[0.98] tracking-[-0.02em] text-[#0041d9]"
          style="font-size:clamp(2.25rem,6vw,5.25rem)"
        >
          <span class="block">Now designing how</span>
          <span class="block">
            AI products
            <span class="ml-[0.3em] font-serif font-normal italic tracking-[-0.01em]"
              >think</span
            >,
          </span>
          <span class="block">not just how they look.</span>
        </h1>
        <a
          href="#work"
          class="group mt-12 inline-flex items-center gap-2 text-sm font-medium"
        >
          <span class="border-b border-ink/30 pb-0.5 group-hover:border-ink"
            >See selected work</span
          >
          <span class="transition-transform group-hover:translate-y-0.5">↓</span>
        </a>
      </div>

      <!-- Image pair for tablet / mobile (below the text) -->
      <div class="mt-14 grid w-full max-w-md grid-cols-2 gap-5 xl:hidden">
        <figure class="-rotate-2">
          <img
            src="https://picsum.photos/seed/pan-desk/600/440"
            alt=""
            loading="lazy"
            class="w-full rounded-2xl object-cover shadow-[0_18px_50px_-20px_rgba(16,24,40,0.35)]"
          />
          <figcaption
            class="mt-2 text-left font-mono text-[11px] uppercase tracking-wide text-[#0041d9]"
          >
            [09:14] first coffee
          </figcaption>
        </figure>
        <figure class="rotate-2">
          <img
            src="https://picsum.photos/seed/pan-screen/600/440"
            alt=""
            loading="lazy"
            class="w-full rounded-2xl object-cover shadow-[0_18px_50px_-20px_rgba(16,24,40,0.35)]"
          />
          <figcaption
            class="mt-2 text-left font-mono text-[11px] uppercase tracking-wide text-[#0041d9]"
          >
            [16:07] model thinking
          </figcaption>
        </figure>
      </div>
    </section>

    <!-- ===================== Selected work ===================== -->
    <section id="work" class="scroll-mt-24 py-16 sm:py-24">
      <div class="mb-10 flex items-end justify-between">
        <h2 class="font-display text-sm font-semibold uppercase tracking-wide">
          Selected work
        </h2>
        <span class="font-sans text-sm text-muted">{projects.length} projects</span>
      </div>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        {
          projects.map((p) => (
            <a
              href={`/work/${p.slug}`}
              class="group block overflow-hidden rounded-card bg-card shadow-[0_10px_40px_-24px_rgba(16,24,40,0.25)] transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_24px_60px_-24px_rgba(16,24,40,0.3)]"
            >
              <div class="overflow-hidden bg-surface">
                <img
                  src={p.cover}
                  alt={`${p.client} — ${p.title}`}
                  loading="lazy"
                  class="aspect-[16/10] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                />
              </div>
              <div class="p-7 sm:p-8">
                <div class="flex items-baseline justify-between gap-4">
                  <p class="font-mono text-xs uppercase tracking-wide text-[#0041d9]">
                    {p.client}
                  </p>
                  <span class="font-sans text-sm tabular-nums text-muted">
                    {p.year}
                  </span>
                </div>
                <h3 class="mt-2 font-display text-2xl font-semibold tracking-tight sm:text-3xl">
                  {p.title}
                </h3>
                <p class="mt-1 font-serif text-xl italic text-ink/80 sm:text-2xl">
                  {p.subtitle}
                </p>
                <div class="mt-5 flex items-center justify-between">
                  <span class="font-sans text-xs uppercase tracking-wide text-muted">
                    {p.role}
                  </span>
                  <span class="font-sans text-sm font-medium text-[#0041d9] opacity-0 transition-opacity group-hover:opacity-100">
                    View case study →
                  </span>
                </div>
              </div>
            </a>
          ))
        }
      </div>
    </section>

    <!-- ===================== About ===================== -->
    <section id="about" class="scroll-mt-24 py-16 sm:py-24">
      <h2
        class="mb-10 font-display text-sm font-semibold uppercase tracking-wide"
      >
        About
      </h2>
      <div class="grid grid-cols-1 gap-10 md:grid-cols-[1.5fr_1fr] md:gap-16">
        <div>
          <p
            class="font-display text-2xl font-semibold leading-snug tracking-tight sm:text-3xl"
          >
            I'm I-Chieh, a senior product designer at New Relic with 7+ years
            delivering user-centered design for enterprise SaaS.
          </p>
          <div class="mt-6 space-y-5 text-lg leading-relaxed text-muted">
            <p>
              I specialise in observability and DevOps tooling — translating
              massive, data-intensive systems into intuitive experiences that
              empower technical users. Most recently, I led the product design
              for Session Replay, a feature adopted by over 1,000 accounts and
              generating $3.52M in monthly recurring revenue within nine months.
            </p>
            <p>
              I'm constantly adding to my hands-on coding skills to build the
              best digital products I can — I recently built {" "}
              <a
                href={LINKS.aiApp}
                target="_blank"
                rel="noopener noreferrer"
                class="text-[#0041d9] underline-offset-4 hover:underline"
                >an AI news app</a
              > with Claude Code, designed to keep UX professionals informed and
              inspired.
            </p>
          </div>

          <dl class="mt-10 space-y-3 border-t border-line/70 pt-6">
            {
              CAREER.map((c) => (
                <div class="flex items-baseline justify-between gap-4 text-sm">
                  <dt>
                    <span class="font-medium text-ink">{c.org}</span>
                    <span class="text-muted"> · {c.role}</span>
                  </dt>
                  <dd class="shrink-0 font-mono text-xs tabular-nums text-muted">
                    {c.period}
                  </dd>
                </div>
              ))
            }
          </dl>
        </div>

        <div>
          <img
            src="/images/about/portrait.jpg"
            alt="I-Chieh Pan"
            class="w-full rounded-card object-cover shadow-[0_18px_50px_-24px_rgba(16,24,40,0.3)]"
          />
        </div>
      </div>
    </section>

    <!-- ===================== Contact ===================== -->
    <section id="contact" class="scroll-mt-24 py-24 sm:py-36">
      <p
        class="font-display font-semibold leading-[0.95] tracking-[-0.03em]"
        style="font-size:clamp(2rem,6vw,5rem)"
      >
        Let's make something
        <span class="font-serif font-normal italic">worth keeping.</span>
      </p>
      <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-3">
        <a
          href={LINKS.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center gap-2 font-sans text-lg font-medium"
        >
          <span class="border-b border-ink/30 pb-0.5 group-hover:border-ink"
            >Connect on LinkedIn</span
          >
          <span class="transition-transform group-hover:translate-x-0.5">→</span>
        </a>
        <a
          href={LINKS.github}
          target="_blank"
          rel="noopener noreferrer"
          class="font-sans text-sm uppercase tracking-wide text-muted hover:text-ink"
          >GitHub</a
        >
        <a
          href={LINKS.resume}
          target="_blank"
          rel="noopener noreferrer"
          class="font-sans text-sm uppercase tracking-wide text-muted hover:text-ink"
          >Résumé</a
        >
      </div>
    </section>
  </main>

  <!-- ===================== Footer ===================== -->
  <footer class="border-t border-line">
    <div
      class="mx-auto flex max-w-[1400px] flex-col gap-2 px-6 py-8 font-sans text-sm text-muted sm:flex-row sm:items-center sm:justify-between sm:px-10"
    >
      <span>© {new Date().getFullYear()} I-Chieh Pan</span>
      <a href="#top" class="hover:text-ink">↑ Back to top</a>
    </div>
  </footer>

  <!-- Live local clock — a small craft detail in the top bar. -->
  <script is:inline define:vars={{ tz: LOCATION.tz }}>
    const el = document.getElementById("clock");
    if (el) {
      const fmt = new Intl.DateTimeFormat("en-GB", {
        hour: "2-digit",
        minute: "2-digit",
        second: "2-digit",
        hour12: false,
        timeZone: tz,
      });
      const tick = () => {
        el.textContent = fmt.format(new Date());
      };
      tick();
      setInterval(tick, 1000);
    }
  </script>
</Layout>
