---
import Layout from "../layouts/Layout.astro";
import { projects } from "../data/projects";

const LINKS = {
  email: "mailto:mail@panichieh.com",
  linkedin: "https://www.linkedin.com/in/ichieh-pan-919344b3/",
  github: "https://github.com/ichieh-pan",
  resume:
    "https://drive.google.com/file/d/1fUN6ntCan-oSVQvz6zIoy8vzJOL9LWLL/view?usp=sharing",
  aiApp: "https://ai-content-aggregator.vercel.app/",
};

// Career timeline (oldest → newest), left to right.
const CAREER = [
  { org: "Acer", year: "2015", url: "https://www.acer.com" },
  {
    org: "Durch die Stadt",
    year: "2017",
    url: "https://intocities.com/berlin/durch-die-stadt-agentur-8856#ath=&atv=&categories=&lat=52.535773&lng=13.474769&scene=&search=&z=",
  },
  { org: "ITONICS", year: "2019", url: "https://www.itonics-innovation.com" },
  { org: "dunnhumby", year: "2021", url: "https://www.dunnhumby.com" },
  { org: "New Relic", year: "2022–now", url: "https://newrelic.com" },
];


---

<Layout>
  <!-- ===================== Top bar ===================== -->
  <header
    class="fixed inset-x-0 top-0 z-50 border-b border-line/60 bg-page"
  >
    <div
      class="mx-auto flex max-w-[1400px] items-center justify-between px-6 py-5 text-ink sm:px-10"
    >
      <a
        href="#top"
        class="font-display text-sm font-extrabold tracking-tight transition-colors hover:text-[#0041d9]"
      >
        I-Chieh Pan
      </a>
      <nav class="flex items-center gap-6 font-sans text-xs tracking-wide">
        <span class="hidden tabular-nums uppercase text-muted sm:inline">
          On page&nbsp;<span id="clock">0:00</span>
        </span>
        <a href="#work" class="font-semibold uppercase hover:opacity-60">Work</a>
        <a href="#about" class="font-semibold uppercase hover:opacity-60">About</a>
        <a href="#contact" class="font-semibold uppercase hover:opacity-60">Contact</a>
      </nav>
    </div>
  </header>

  <main id="top" class="mx-auto max-w-[1400px] px-6 sm:px-10">
    <!-- ===================== Hero ===================== -->
    <section
      class="relative flex min-h-[92svh] flex-col items-center justify-center pt-28 pb-20 text-center"
    >
      <!-- Neural-net graph, left of the heading (desktop only) -->
      <img
        src="/images/ann-graph.svg"
        alt=""
        class="pointer-events-none absolute left-[-1rem] top-[26%] z-0 hidden w-[clamp(200px,20vw,300px)] -translate-y-1/2 opacity-70 mix-blend-multiply xl:block"
      />

      <!-- Floating animation (desktop only) -->
      <img
        src="/images/epitrochoid.gif"
        alt=""
        class="pointer-events-none absolute right-[-2rem] top-[calc(50%+200px)] z-0 hidden w-[clamp(240px,24vw,340px)] -translate-y-1/2 mix-blend-multiply xl:block"
      />

      <!-- Hero text -->
      <div class="relative z-10 max-w-3xl">
        <p
          class="mb-6 font-sans text-[22px] leading-relaxed text-[#0041d9] sm:whitespace-nowrap sm:text-[24px]"
        >
          8 years designing complex, data-heavy products.
        </p>
        <h1
          class="font-display font-semibold leading-[0.98] tracking-[-0.02em] text-[#0041d9]"
          style="font-size:clamp(2.25rem,6vw,5.25rem)"
        >
          <span class="block">Now designing how</span>
          <span class="block">
            AI products
            <span class="ml-[0.3em] font-serif font-normal italic tracking-[-0.01em]"
              >think</span
            >,
          </span>
          <span class="block">not just how they look.</span>
        </h1>
        <a
          href="#work"
          class="group mt-12 inline-flex items-center gap-2 text-sm font-medium"
        >
          <span class="border-b border-ink/30 pb-0.5 group-hover:border-ink"
            >See selected work</span
          >
          <span class="transition-transform group-hover:translate-y-0.5">↓</span>
        </a>
      </div>

      <!-- Animation for tablet / mobile (below the text) -->
      <div class="mt-12 flex justify-center xl:hidden">
        <img
          src="/images/epitrochoid.gif"
          alt=""
          class="w-64 mix-blend-multiply"
        />
      </div>
    </section>

    <!-- ===================== Selected work ===================== -->
    <section id="work" class="scroll-mt-24 py-16 sm:py-24">
      <div class="mb-10 flex items-end justify-between">
        <h2 class="font-display text-sm font-semibold uppercase tracking-wide">
          Selected work
        </h2>
        <span class="font-sans text-sm text-muted">{projects.length} projects</span>
      </div>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        {
          projects.map((p) => (
            <a
              href={`/work/${p.slug}`}
              class="group block overflow-hidden rounded-card bg-card shadow-[0_10px_40px_-24px_rgba(16,24,40,0.25)] transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_24px_60px_-24px_rgba(16,24,40,0.3)]"
            >
              <div class="overflow-hidden bg-surface">
                {
                  p.cover ? (
                    p.coverPad ? (
                      <div class="flex aspect-[16/10] w-full items-start justify-center bg-surface p-6 sm:p-8">
                        <img
                          src={p.cover}
                          alt={`${p.client} — ${p.title}`}
                          loading="lazy"
                          class:list={[
                            "max-h-full rounded-lg object-contain shadow-[0_12px_32px_-12px_rgba(16,24,40,0.45)] transition-transform duration-500",
                            p.coverPadScale === 92
                              ? "scale-[0.92] group-hover:scale-[0.948]"
                              : p.coverPadScale === 96
                                ? "scale-[0.96] group-hover:scale-[0.988]"
                                : "group-hover:scale-[1.03]",
                          ]}
                        />
                      </div>
                    ) : p.coverScale ? (
                      <div class="aspect-[16/10] w-full overflow-hidden bg-surface">
                        <img
                          src={p.cover}
                          alt={`${p.client} — ${p.title}`}
                          loading="lazy"
                          class:list={[
                            "h-full w-full object-cover transition-transform duration-500",
                            p.coverScale === 85
                              ? "scale-[0.85] group-hover:scale-[0.876]"
                              : p.coverScale === 82
                                ? "scale-[0.82] shadow-[0_24px_60px_-16px_rgba(16,24,40,0.35)] group-hover:scale-[0.845]"
                                : p.coverScale === 86
                                  ? "scale-[0.86] rounded-[8px] shadow-[0_8px_22px_-6px_rgba(16,24,40,0.35)] group-hover:scale-[0.886]"
                                  : p.coverScale === 84
                                    ? "scale-[0.84] rounded-[8px] shadow-[0_8px_22px_-6px_rgba(16,24,40,0.35)] group-hover:scale-[0.865]"
                                    : "scale-90 group-hover:scale-[0.927]",
                          ]}
                        />
                      </div>
                    ) : (
                      <img
                        src={p.cover}
                        alt={`${p.client} — ${p.title}`}
                        loading="lazy"
                        class="aspect-[16/10] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                      />
                    )
                  ) : (
                    <div class="flex aspect-[16/10] w-full items-center justify-center bg-[#0041d9]/[0.06]">
                      <span class="font-mono text-xs uppercase tracking-wide text-[#0041d9]">
                        {p.client}
                      </span>
                    </div>
                  )
                }
              </div>
              <div class="p-7 sm:p-8">
                <div class="flex items-baseline justify-between gap-4">
                  <p class="font-mono text-xs uppercase tracking-wide text-[#0041d9]">
                    {p.client}
                  </p>
                  <span class="font-sans text-sm tabular-nums text-muted">
                    {p.year}
                  </span>
                </div>
                <h3 class="mt-2 font-display text-2xl font-semibold tracking-tight sm:text-3xl">
                  {p.title}
                </h3>
                <p class="font-display text-lg font-semibold leading-snug tracking-tight text-ink sm:text-xl">
                  {p.subtitle}
                </p>
                <div class="mt-10 flex items-center justify-between">
                  <span class="font-sans text-xs uppercase tracking-wide text-muted">
                    {p.discipline}
                  </span>
                  <span class="font-sans text-sm font-medium text-[#0041d9] opacity-0 transition-opacity group-hover:opacity-100">
                    View case study →
                  </span>
                </div>
              </div>
            </a>
          ))
        }
      </div>
    </section>

    <!-- ===================== About ===================== -->
    <section id="about" class="scroll-mt-24 py-16 sm:py-24">
      <h2
        class="mb-10 font-display text-sm font-semibold uppercase tracking-wide"
      >
        About
      </h2>
      <div
        class="grid grid-cols-1 gap-10 md:grid-cols-[1fr_auto] md:items-start md:gap-16"
      >
        <div>
          <p
            class="font-display text-2xl font-semibold leading-snug tracking-tight sm:text-3xl"
          >
            I'm I-Chieh, a senior product designer at New Relic with 8 years of
            experience designing enterprise SaaS, specializing in data-intensive
            systems and operational tooling.
          </p>
          <p
            class="mt-6 font-display text-2xl font-semibold leading-snug tracking-tight sm:text-3xl"
          >
            Lately, that work has been moving out of static mockups. I now
            prototype directly in <span class="font-semibold text-[#0041d9]"
              >Claude Code</span
            > with our <span class="font-semibold text-[#0041d9]"
              >production components</span
            >, so I can iterate and test rapidly, getting to a faster answer on
            whether we're building the right product.
          </p>

          <!-- Experience timeline -->
          <div class="mt-12 sm:mt-16">
            <p class="mb-8 font-mono text-xs uppercase tracking-wide text-muted">
              Experience
            </p>
            <div class="relative">
              <div
                class="absolute left-[10%] right-[10%] top-[7px] h-px bg-line"
              />
              <ol class="relative flex justify-between gap-2">
                {
                  CAREER.map((c) => (
                    <li class="flex flex-1 flex-col items-center text-center">
                      <span class="h-3.5 w-3.5 rounded-full bg-[#0041d9] ring-4 ring-page" />
                      <span class="mt-4 font-mono text-xs tabular-nums text-muted">
                        {c.year}
                      </span>
                      {
                        c.url ? (
                          <a
                            href={c.url}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="mt-1 text-xs font-medium text-ink underline-offset-4 hover:text-[#0041d9] hover:underline"
                          >
                            {c.org}
                          </a>
                        ) : (
                          <span class="mt-1 text-xs font-medium text-ink">
                            {c.org}
                          </span>
                        )
                      }
                    </li>
                  ))
                }
              </ol>
            </div>
          </div>
        </div>

        <div class="pt-2 md:pl-6">
          <img
            src="/images/about/portrait-color.png"
            alt="I-Chieh Pan"
            class="w-[240px]"
          />
        </div>
      </div>
    </section>
  </main>

  <!-- ===================== Contact (full-bleed footer) ===================== -->
  <section
    id="contact"
    class="mt-24 scroll-mt-24 bg-[#0041d9] text-white sm:mt-48"
  >
    <div class="mx-auto max-w-[1400px] px-6 py-16 sm:px-10 sm:py-20">
        <p
          class="font-display font-semibold leading-[0.95] tracking-[-0.03em]"
          style="font-size:clamp(2rem,6vw,5rem)"
        >
          Let's make complex data
          <span class="ml-[0.3em] font-serif font-normal italic"
            >feel simple.</span
          >
        </p>
        <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-3">
          <a
            href={LINKS.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center gap-2 font-sans text-lg font-medium"
          >
            <span
              class="border-b border-white/40 pb-0.5 group-hover:border-white"
              >Connect on LinkedIn</span
            >
            <span class="transition-transform group-hover:translate-x-0.5">→</span>
          </a>
          <a
            href={LINKS.email}
            class="font-sans text-sm uppercase tracking-wide text-white/70 hover:text-white"
            >Email</a
          >
          <a
            href={LINKS.github}
            target="_blank"
            rel="noopener noreferrer"
            class="font-sans text-sm uppercase tracking-wide text-white/70 hover:text-white"
            >GitHub</a
          >
          <a
            href={LINKS.resume}
            target="_blank"
            rel="noopener noreferrer"
            class="font-sans text-sm uppercase tracking-wide text-white/70 hover:text-white"
            >Résumé</a
          >
        </div>
        <div
          class="mt-16 flex flex-col gap-2 border-t border-white/20 pt-6 font-sans text-xs text-white/70 sm:flex-row sm:items-center sm:justify-between"
        >
          <span>© {new Date().getFullYear()} I-Chieh Pan</span>
          <a href="#top" class="hover:text-white">↑ Back to top</a>
        </div>
      </div>
    </section>

  <!-- Time-on-page counter — a small craft detail in the top bar. -->
  <script is:inline>
    const el = document.getElementById("clock");
    if (el) {
      const start = Date.now();
      const tick = () => {
        const s = Math.floor((Date.now() - start) / 1000);
        const h = Math.floor(s / 3600);
        const m = Math.floor((s % 3600) / 60);
        const sec = String(s % 60).padStart(2, "0");
        el.textContent = h
          ? `${h}:${String(m).padStart(2, "0")}:${sec}`
          : `${m}:${sec}`;
      };
      tick();
      setInterval(tick, 1000);
    }
  </script>
</Layout>
