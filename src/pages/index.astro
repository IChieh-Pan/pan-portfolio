---
import Layout from "../layouts/Layout.astro";
import { projects } from "../data/projects";
import BlobBlue from "../components/BlobBlue.astro";
import BlobLime from "../components/BlobLime.astro";

// Your location powers the live clock in the top bar.
// TODO: confirm your city (currently a guess).
const LOCATION = { city: "Taipei", tz: "Asia/Taipei" };

const LINKS = {
  linkedin: "https://www.linkedin.com/in/ichieh-pan-919344b3/",
  github: "https://github.com/ichieh-pan",
  resume:
    "https://drive.google.com/file/d/1MVwI1dfrhawCBHaIXMVsvl0lk-nT-ZiO/view?usp=sharing",
  aiApp: "https://ai-content-aggregator.vercel.app/",
};

// Keyword tags for the About section — varied size / color / tilt so the
// cloud feels playful rather than a tidy row. `cls` carries per-pill styling.
const TAGS = [
  { label: "Observability", cls: "px-5 py-2.5 text-lg bg-[#3e77b6] text-page -rotate-[5deg]" },
  { label: "DevOps tooling", cls: "px-3.5 py-1.5 text-sm bg-[#FFF600] text-[#1b1b18] rotate-[4deg] mt-3" },
  { label: "Data-intensive systems", cls: "px-4 py-2 text-base bg-[#d98fb9] text-[#1b1b18] -rotate-[3deg]" },
  { label: "Enterprise SaaS", cls: "px-3.5 py-1.5 text-sm bg-[#FFF600] text-[#1b1b18] rotate-[6deg]" },
  { label: "Design systems", cls: "px-4 py-2 text-base bg-[#3e77b6] text-page rotate-[3deg] mt-2" },
  { label: "User research", cls: "px-5 py-2.5 text-lg bg-[#d98fb9] text-[#1b1b18] -rotate-[6deg]" },
  { label: "Prototyping", cls: "px-3.5 py-1.5 text-sm bg-[#FFF600] text-[#1b1b18] rotate-[5deg]" },
  { label: "AI-native products", cls: "px-4 py-2 text-base bg-[#d98fb9] text-[#1b1b18] -rotate-[4deg] mt-1" },
];

---

<Layout>
  <!-- ===================== Top bar ===================== -->
  <header
    class="fixed inset-x-0 top-0 z-50 border-b border-line/60 bg-page"
  >
    <div
      class="mx-auto flex max-w-[1400px] items-center justify-between px-6 py-5 text-ink sm:px-10"
    >
      <a href="#top" class="font-display text-sm font-semibold tracking-tight">
        I-Chieh Pan
      </a>
      <nav class="flex items-center gap-6 font-sans text-xs tracking-wide">
        <span class="hidden tabular-nums uppercase text-muted sm:inline">
          {LOCATION.city}&nbsp;<span id="clock">--:--:--</span>
        </span>
        <a href="#work" class="hover:opacity-60">Work</a>
        <a href="#about" class="hover:opacity-60">About</a>
        <a href="#contact" class="hover:opacity-60">Contact</a>
      </nav>
    </div>
  </header>

  <main id="top" class="mx-auto max-w-[1400px] px-6 sm:px-10">
    <!-- ===================== Hero ===================== -->
    <section
      class="relative flex min-h-[92svh] flex-col items-center justify-center pt-28 pb-20 text-center"
    >
      <!-- Floating shape — left / upper (desktop only) -->
      <BlobBlue
        class="animate-float absolute left-0 top-[14%] z-0 hidden w-[clamp(180px,18vw,260px)] -rotate-[34deg] xl:block"
      />

      <!-- Floating shape — right / lower (desktop only) -->
      <BlobLime
        class="animate-float-slow absolute right-0 bottom-[12%] z-0 hidden w-[clamp(150px,14vw,190px)] rotate-6 xl:block"
      />

      <!-- Hero text -->
      <div class="relative z-10 max-w-3xl">
        <p
          class="mb-6 font-sans text-[22px] leading-relaxed text-[#0041d9] sm:whitespace-nowrap sm:text-[24px]"
        >
          7+ years designing complex, data-heavy products.
        </p>
        <h1
          class="font-display font-semibold leading-[0.98] tracking-[-0.02em] text-[#0041d9]"
          style="font-size:clamp(2.25rem,6vw,5.25rem)"
        >
          <span class="block">Now designing how</span>
          <span class="block">
            AI products
            <span class="ml-[0.3em] font-serif font-normal italic tracking-[-0.01em]"
              >think</span
            >,
          </span>
          <span class="block">not just how they look.</span>
        </h1>
        <a
          href="#work"
          class="group mt-12 inline-flex items-center gap-2 text-sm font-medium"
        >
          <span class="border-b border-ink/30 pb-0.5 group-hover:border-ink"
            >See selected work</span
          >
          <span class="transition-transform group-hover:translate-y-0.5">↓</span>
        </a>
      </div>

      <!-- Shape pair for tablet / mobile (below the text) -->
      <div
        class="mt-14 flex w-full max-w-sm items-center justify-center gap-10 xl:hidden"
      >
        <BlobBlue class="animate-float w-1/2 -rotate-[34deg]" />
        <BlobLime class="animate-float-slow w-2/5 rotate-6" />
      </div>
    </section>

    <!-- ===================== Selected work ===================== -->
    <section id="work" class="scroll-mt-24 py-16 sm:py-24">
      <div class="mb-10 flex items-end justify-between">
        <h2 class="font-display text-sm font-semibold uppercase tracking-wide">
          Selected work
        </h2>
        <span class="font-sans text-sm text-muted">{projects.length} projects</span>
      </div>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        {
          projects.map((p) => (
            <a
              href={`/work/${p.slug}`}
              class="group block overflow-hidden rounded-card bg-card shadow-[0_10px_40px_-24px_rgba(16,24,40,0.25)] transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_24px_60px_-24px_rgba(16,24,40,0.3)]"
            >
              <div class="overflow-hidden bg-surface">
                <img
                  src={p.cover}
                  alt={`${p.client} — ${p.title}`}
                  loading="lazy"
                  class="aspect-[16/10] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                />
              </div>
              <div class="p-7 sm:p-8">
                <div class="flex items-baseline justify-between gap-4">
                  <p class="font-mono text-xs uppercase tracking-wide text-[#0041d9]">
                    {p.client}
                  </p>
                  <span class="font-sans text-sm tabular-nums text-muted">
                    {p.year}
                  </span>
                </div>
                <h3 class="mt-2 font-display text-2xl font-semibold tracking-tight sm:text-3xl">
                  {p.title}
                </h3>
                <p class="mt-2 font-sans text-base leading-snug text-ink/75 sm:text-lg">
                  {p.subtitle}
                </p>
                <div class="mt-5 flex items-center justify-between">
                  <span class="font-sans text-xs uppercase tracking-wide text-muted">
                    {p.role}
                  </span>
                  <span class="font-sans text-sm font-medium text-[#0041d9] opacity-0 transition-opacity group-hover:opacity-100">
                    View case study →
                  </span>
                </div>
              </div>
            </a>
          ))
        }
      </div>
    </section>

    <!-- ===================== About ===================== -->
    <section id="about" class="scroll-mt-24 py-16 sm:py-24">
      <h2
        class="mb-10 font-display text-sm font-semibold uppercase tracking-wide"
      >
        About
      </h2>
      <div class="grid grid-cols-1 gap-10 md:grid-cols-[1.5fr_1fr] md:gap-16">
        <div>
          <p
            class="font-display text-2xl font-semibold leading-snug tracking-tight sm:text-3xl"
          >
            I'm I-Chieh, a senior product designer at New Relic with 7+ years
            delivering user-centered design for enterprise SaaS.
          </p>
          <ul class="mt-8 flex flex-wrap items-center gap-x-3 gap-y-2">
            {
              TAGS.map((t) => (
                <li
                  class:list={[
                    "inline-block rounded-full font-medium shadow-[0_8px_24px_-16px_rgba(16,24,40,0.4)] transition-transform duration-200 hover:rotate-0",
                    t.cls,
                  ]}
                >
                  {t.label}
                </li>
              ))
            }
            <li class="rotate-[5deg] shadow-[0_8px_24px_-16px_rgba(16,24,40,0.4)] transition-transform duration-200 hover:rotate-0">
              <a
                href={LINKS.aiApp}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-block rounded-full bg-[#3e77b6] px-4 py-2 text-base font-medium text-page"
              >
                AI news app ↗
              </a>
            </li>
          </ul>
        </div>

        <div class="pt-2 md:pl-6">
          <img
            src="/images/about/portrait.jpg"
            alt="I-Chieh Pan"
            class="w-3/4 max-w-[300px] rounded-2xl object-cover shadow-[0_18px_50px_-24px_rgba(16,24,40,0.3)]"
          />
        </div>
      </div>
    </section>

    <!-- ===================== Contact ===================== -->
    <section id="contact" class="scroll-mt-24 pt-24 pb-44 sm:pt-36 sm:pb-56">
      <p
        class="font-display font-semibold leading-[0.95] tracking-[-0.03em]"
        style="font-size:clamp(2rem,6vw,5rem)"
      >
        Let's make something
        <span class="ml-[0.3em] font-serif font-normal italic">worth keeping.</span>
      </p>
      <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-3">
        <a
          href={LINKS.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center gap-2 font-sans text-lg font-medium"
        >
          <span class="border-b border-ink/30 pb-0.5 group-hover:border-ink"
            >Connect on LinkedIn</span
          >
          <span class="transition-transform group-hover:translate-x-0.5">→</span>
        </a>
        <a
          href={LINKS.github}
          target="_blank"
          rel="noopener noreferrer"
          class="font-sans text-sm uppercase tracking-wide text-muted hover:text-ink"
          >GitHub</a
        >
        <a
          href={LINKS.resume}
          target="_blank"
          rel="noopener noreferrer"
          class="font-sans text-sm uppercase tracking-wide text-muted hover:text-ink"
          >Résumé</a
        >
      </div>
    </section>
  </main>

  <!-- ===================== Footer ===================== -->
  <footer class="border-t border-line">
    <div
      class="mx-auto flex max-w-[1400px] flex-col gap-2 px-6 py-8 font-sans text-xs text-muted sm:flex-row sm:items-center sm:justify-between sm:px-10"
    >
      <span>© {new Date().getFullYear()} I-Chieh Pan</span>
      <a href="#top" class="hover:text-ink">↑ Back to top</a>
    </div>
  </footer>

  <!-- Live local clock — a small craft detail in the top bar. -->
  <script is:inline define:vars={{ tz: LOCATION.tz }}>
    const el = document.getElementById("clock");
    if (el) {
      const fmt = new Intl.DateTimeFormat("en-GB", {
        hour: "2-digit",
        minute: "2-digit",
        second: "2-digit",
        hour12: false,
        timeZone: tz,
      });
      const tick = () => {
        el.textContent = fmt.format(new Date());
      };
      tick();
      setInterval(tick, 1000);
    }
  </script>
</Layout>
