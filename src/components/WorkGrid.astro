---
import type { Project } from "../data/projects";

interface Props {
  projects: Project[];
}
const { projects } = Astro.props;
---

<div class="grid grid-cols-1 gap-6 md:grid-cols-2">
  {
    projects.map((p) => (
      <a
        href={`/work/${p.slug}`}
        class="group block overflow-hidden rounded-card bg-card shadow-[0_10px_40px_-24px_rgba(16,24,40,0.25)] transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_24px_60px_-24px_rgba(16,24,40,0.3)]"
      >
        <div class="overflow-hidden bg-surface">
          {p.cover ? (
            p.coverPad ? (
              <div class="flex aspect-[16/10] w-full items-start justify-center bg-surface p-6 sm:p-8">
                <img
                  src={p.cover}
                  alt={`${p.client} — ${p.title}`}
                  loading="lazy"
                  class:list={[
                    "max-h-full rounded-lg object-contain shadow-[0_12px_32px_-12px_rgba(16,24,40,0.45)] transition-transform duration-500",
                    p.coverPadScale === 92
                      ? "scale-[0.92] group-hover:scale-[0.948]"
                      : p.coverPadScale === 96
                        ? "scale-[0.96] group-hover:scale-[0.988]"
                        : "group-hover:scale-[1.03]",
                  ]}
                />
              </div>
            ) : p.coverScale ? (
              <div class="aspect-[16/10] w-full overflow-hidden bg-surface">
                <img
                  src={p.cover}
                  alt={`${p.client} — ${p.title}`}
                  loading="lazy"
                  class:list={[
                    "h-full w-full object-cover transition-transform duration-500",
                    p.coverScale === 85
                      ? "scale-[0.85] group-hover:scale-[0.876]"
                      : p.coverScale === 82
                        ? "scale-[0.82] shadow-[0_24px_60px_-16px_rgba(16,24,40,0.35)] group-hover:scale-[0.845]"
                        : p.coverScale === 86
                          ? "scale-[0.86] rounded-[8px] shadow-[0_8px_22px_-6px_rgba(16,24,40,0.35)] group-hover:scale-[0.886]"
                          : p.coverScale === 84
                            ? "scale-[0.84] rounded-[8px] shadow-[0_8px_22px_-6px_rgba(16,24,40,0.18)] group-hover:scale-[0.865]"
                            : "scale-90 group-hover:scale-[0.927]",
                  ]}
                />
              </div>
            ) : (
              <img
                src={p.cover}
                alt={`${p.client} — ${p.title}`}
                loading="lazy"
                class:list={[
                  "aspect-[16/10] w-full object-cover transition-transform duration-500",
                  p.coverEnlarge
                    ? "scale-[1.07] group-hover:scale-[1.1]"
                    : "group-hover:scale-[1.03]",
                ]}
              />
            )
          ) : (
            <div class="flex aspect-[16/10] w-full items-center justify-center bg-[#0041d9]/[0.06]">
              <span class="font-mono text-xs uppercase tracking-wide text-[#0041d9]">
                {p.client}
              </span>
            </div>
          )}
        </div>
        <div class="p-7 sm:p-8">
          <div class="flex items-baseline justify-between gap-4">
            <p class="font-mono text-xs uppercase tracking-wide text-[#0041d9]">
              {p.client}
            </p>
            <span class="font-sans text-sm tabular-nums text-muted">
              {p.year}
            </span>
          </div>
          <h3 class="mt-2 font-display text-2xl font-semibold tracking-tight sm:text-3xl">
            {p.title}
          </h3>
          <p class="font-display text-lg font-semibold leading-snug tracking-tight text-ink sm:text-xl">
            {p.subtitle}
          </p>
          <div class="mt-10 flex items-center justify-between">
            <span class="font-sans text-xs uppercase tracking-wide text-muted">
              {p.discipline}
            </span>
            <span class="font-sans text-sm font-medium text-[#0041d9] opacity-0 transition-opacity group-hover:opacity-100">
              View case study →
            </span>
          </div>
        </div>
      </a>
    ))
  }
</div>
