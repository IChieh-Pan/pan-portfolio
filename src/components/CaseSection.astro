---
// A numbered case-study section: small mono number + display heading, then a slot.
interface Props {
  num?: string;
  title: string;
}
const { num, title } = Astro.props;
---

<section class="mx-auto max-w-5xl border-t border-line/70 px-6 pt-14 sm:px-10 sm:pt-20">
  <h2
    class="mb-7 font-display text-3xl font-semibold tracking-tight text-ink sm:text-4xl"
  >
    {title}
  </h2>
  <slot />
</section>
