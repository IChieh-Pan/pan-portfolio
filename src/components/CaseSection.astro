---
// A numbered case-study section: small mono number + display heading, then a slot.
interface Props {
  num?: string;
  title: string;
}
const { num, title } = Astro.props;
---

<section class="mx-auto max-w-5xl border-t border-line/70 px-6 pt-10 sm:px-10 sm:pt-16">
  <div class="mb-7 flex items-baseline gap-4">
    {num && <span class="font-mono text-sm text-[#0041d9]">{num}</span>}
    <h2
      class="font-display text-3xl font-semibold tracking-tight text-ink sm:text-4xl"
    >
      {title}
    </h2>
  </div>
  <slot />
</section>
