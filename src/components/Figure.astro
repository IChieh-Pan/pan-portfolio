---
// An image with an optional monospace caption.
// `zoom` (e.g. "scale-110") enlarges the image inside a fixed-size, clipped
// card — useful for source images that have whitespace baked into the file.
interface Props {
  src: string;
  alt?: string;
  caption?: string;
  class?: string;
  zoom?: string;
}
const { src, alt = "", caption, class: className = "", zoom } = Astro.props;
---

<figure class:list={["my-8", className]}>
  {
    zoom ? (
      <div class="overflow-hidden rounded-2xl bg-card shadow-[0_18px_50px_-24px_rgba(16,24,40,0.28)]">
        <img src={src} alt={alt} loading="lazy" class:list={["w-full", zoom]} />
      </div>
    ) : (
      <img
        src={src}
        alt={alt}
        loading="lazy"
        class="w-full rounded-2xl bg-card shadow-[0_18px_50px_-24px_rgba(16,24,40,0.28)]"
      />
    )
  }
  {
    caption && (
      <figcaption class="mt-3 font-mono text-xs uppercase tracking-wide text-muted">
        {caption}
      </figcaption>
    )
  }
</figure>
